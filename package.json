{
  "name": "cc-wrap",
  "version": "1.0.0",
  "description": "cc-wrap Desktop",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "rebuild": "electron-rebuild"
  },
  "build": {
    "appId": "com.ccwrap.app",
    "productName": "cc-wrap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "cc-wrap",
      "uninstallDisplayName": "cc-wrap"
    }
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "electron-store": "^8.1.0",
    "sharp": "^0.34.5",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "electron": "^28.1.3",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "png-to-ico": "^3.0.1"
  }
}
